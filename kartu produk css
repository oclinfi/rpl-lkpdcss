* {
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background-color: #f4f6f8;
  padding: 20px;
}

.judul-halaman {
  text-align: center;
  color: #1F4E79;
  margin-bottom: 25px;
}

.kartu-produk {
  box-sizing: border-box;
  width: 280px;
  padding: 16px;
  border: 2px solid #2E75B6;
  margin: 15px auto; /* Margin atas-bawah 15px dan posisi di tengah secara horizontal */
  background-color: #ffffff;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.kartu-produk h2 {
  margin-top: 0;
  color: #1F4E79;
  font-size: 18px;
}

.harga {
  color: #c0392b;
  font-weight: bold;
  font-size: 16px;
  margin: 8px 0;
}

.deskripsi {
  color: #555555;
  font-size: 14px;
  line-height: 1.4;
}
