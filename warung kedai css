body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  background-color: #fdfdfd;
  color: #333333;
  padding: 20px;
}

header nav ul {
  list-style: none;
  padding: 0;
  margin-bottom: 30px;
}

header nav li {
  display: inline-block;
  margin-right: 15px;
}

nav a {
  text-decoration: none;
  color: #1F4E79;
  font-weight: bold;
  padding: 6px 12px;
  border-radius: 4px;
}

nav a:hover {
  color: white;
  background-color: #1F4E79;
}

/* Grouping Selector */
h1, h2 {
  font-family: 'Segoe UI', Arial, sans-serif;
}

h1 {
  text-align: center;
  color: darkred;
  margin-bottom: 15px;
}

h2 {
  color: #2c3e50;
  border-bottom: 2px solid #2c3e50;
  padding-bottom: 5px;
  margin-top: 30px;
}

.seksi-artikel {
  max-width: 800px;
  margin: 0 auto 30px auto;
}

.deskripsi-artikel {
  font-size: 16px;
  margin-bottom: 15px;
}

.daftar-menu ul {
  padding-left: 20px;
}

.daftar-menu li {
  margin-bottom: 10px;
}

.nama-item {
  font-weight: bold;
  color: #1F4E79;
}

.detail-item {
  color: #555555;
}
